# ─────────────────────────────────────────────────────────────
# SovereignWatch .gitignore
# ─────────────────────────────────────────────────────────────

# Environment & secrets
.env
.env.local
.env.*.local
*.pem
*.key
secrets/

# MaxMind GeoIP databases (licensed, download separately)
data/*.mmdb
data/*.tar.gz

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/

# Build outputs
dist/
build/
out/
.next/
.cache/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Docker volumes mirrored locally
pgdata/
changedata/
kumadata/

# Logs
logs/
*.log

# Editor / OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Test outputs
coverage/
.nyc_output/

# Local development
.local/
tmp/
sovpro

# Playwright MCP artifacts
.playwright-mcp/
*.playwright.png

# Claude Code local agent state
.claude/

# MkDocs static build output (rebuild via `docker compose run --rm docs build`).
# Keep the directory + the placeholder index so the nginx bind-mount works on a
# fresh checkout.
mkdocs/site/*
!mkdocs/site/index.html

# Internal-facing docs/ (agent + operator notes, runbooks, plans). Public
# docs live under mkdocs/docs/ — do NOT match those. Leading slash anchors
# this rule to the repo root.
/docs/

# Offsite backup replication helper — host/path-specific infra (homelab SSH
# alias, rsync dest). Kept local-only, out of version control. backup-database.sh
# calls it via a guarded `if` that no-ops if the file is absent on a checkout.
/scripts/replicate-to-offsite.sh
/media-cache/
# Staged geospatial source files (boundary research). Exclude the CONTENTS,
# not the directory itself: git never descends into an excluded directory, so
# a negation under `data/boundaries/` can never fire. PROVENANCE.md files are
# the committed audit trail for the workstream and must stay trackable.
data/boundaries/**
!data/boundaries/**/
!data/boundaries/**/PROVENANCE.md

# Staged roster source files. Same pattern and same reason as data/boundaries
# above: exclude the CONTENTS, keep the directories traversable, and keep the
# PROVENANCE.md committed as the audit trail.
data/rosters/**
!data/rosters/**/
!data/rosters/**/PROVENANCE.md
